{"event_id":"evt_f2e5b3e48fbf4f208daf2242","session_id":"20260701-134303_8fa3a37a","timestamp":"2026-07-01T13:43:05.017Z","elapsed_ms":1809,"type":"round.proposal_submitted","actor":"user","phase":"discussion","round":1,"payload":{"player_id":1,"idea_text":"Eu acredito que uma vida bem vivida é aquela em que nos permitimos ser personagens de nossas próprias histórias, escrevendo capítulos inesperados e abraçando as reviravoltas que nos levam a lugares e experiências que nunca imaginamos.","idea_chars":234}}
