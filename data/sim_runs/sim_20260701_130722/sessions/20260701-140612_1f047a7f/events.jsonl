{"event_id":"evt_f05ef06b40c94369b50c09a6","session_id":"20260701-140612_1f047a7f","timestamp":"2026-07-01T14:06:18.778Z","elapsed_ms":5898,"type":"round.proposal_submitted","actor":"ai_5","phase":"discussion","round":1,"payload":{"player_id":5,"idea_text":"E não é só isso, Dono do Bar. Uma vida bem vivida também é sobre saber que o freguês volta porque confia na gente. No comércio, a confiança é a moeda mais valiosa. Isso traz paz no fim do mês, não é?","stance":"complement","refers_to_name":"Dono do Bar","refers_to_player_id":null,"reasoning_mode":"direct","reasoning":null,"idea_chars":199}}
