{"event_id":"evt_30f08a64175c4d73a939f9bb","session_id":"20260701-131622_c939fe34","timestamp":"2026-07-01T13:16:31.791Z","elapsed_ms":8804,"type":"round.proposal_submitted","actor":"ai_3","phase":"discussion","round":1,"payload":{"player_id":3,"idea_text":"Viver bem não é só ter tempo livre e um sonho bonito. É sobreviver na correria do dia a dia, conseguir pagar as contas e ainda ter um tempo pra respirar. Sem grana, as ideias românticas não valem nada.","stance":"counter","refers_to_name":"Dono do Bar","refers_to_player_id":null,"reasoning_mode":"direct","reasoning":null,"idea_chars":201}}
