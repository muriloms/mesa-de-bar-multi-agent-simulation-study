# Configurações do backend
# Copie este arquivo para .env e ajuste os valores antes de rodar docker compose.

# Origens permitidas pelo CORS (lista separada por vírgulas).
# Padrão cobre o dev local; ajuste se for fazer deploy ou usar outras portas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL base que o frontend vai usar para falar com a API durante o build.
# Padrão usa o nome do serviço backend dentro da rede do docker-compose.
VITE_API_BASE_URL=http://localhost:8000/api

# Chaves de API dos provedores LLM.
# Em desenvolvimento, podem ser configuradas pela interface (modal de
# configurações). Em deploy/automação, preferimos servidor: defina aqui.
GOOGLE_API_KEY=
OPENAI_API_KEY=

# (Fase 5) Caminho do protocolo padrão a ser pré-selecionado no Welcome.
# Se vazio, o sujeito escolhe entre os disponíveis em protocols/.
MDB_DEFAULT_PROTOCOL=

# Análise (Fase C) — backend de embedding: google | local | hash
MDB_EMBED_BACKEND=google
# Chave para embeddings (cai em GOOGLE_API_KEY se não setada)
# MDB_EMBED_API_KEY=
